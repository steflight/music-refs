ADMIN_TOKEN=change-me-generate-a-secret
DATABASE_PATH=/app/data/quotes.db
USER_AGENT=MusicRefs/1.0 (music-refs-dev.kladriva.ca; contact@kladriva.ca)
CORS_ORIGINS=*
# SEC-04 — limite de requêtes d'écriture (POST/PUT/PATCH/DELETE) par IP et par minute ; 0 = désactivé
RATE_LIMIT_PER_MINUTE=120
# MR-08 / MR-14 — Web Push (VAPID). Générer avec : python3 scripts/gen_vapid.py
# Clés absentes = push désactivé (le service démarre quand même).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@kladriva.ca
# Heure locale (fuseau du joueur) du rappel quotidien ; PUSH_SCHEDULER_ENABLED=0 pour couper le planificateur
PUSH_REMINDER_HOUR=19
PUSH_SCHEDULER_ENABLED=1
